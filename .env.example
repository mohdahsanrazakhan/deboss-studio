# Public base URL of the deployed site.
# Used for canonical URLs, sitemap.xml, robots.txt and Open Graph metadata.
# NEXT_PUBLIC_* variables are exposed to the browser: never put secrets here.
NEXT_PUBLIC_SITE_URL=https://textdeboss.example.com

# Gallery submission feature ("request to post on gallery" for saved Sets).
# See docs/GALLERY_SUBMISSION_SETUP.md for how to obtain each value. All
# five must be set to real values or the feature stays inert (see
# isGallerySubmissionConfigured() in src/config/gallery-submission.ts).
# EmailJS is designed for these values to be exposed client-side (unlike a
# traditional API secret), and the Apps Script URL is a public web-app
# endpoint the owner deploys themselves, not a credential.
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_OTP_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_NOTIFY_TEMPLATE_ID=
NEXT_PUBLIC_GALLERY_SHEET_WEBAPP_URL=
